{
  "version": 1,
  "blocks": [
    {
      "type": "hero",
      "eyebrow": "Class 8 Lab · Infographic Mode",
      "title": "RTB Simulation: The Bidding War",
      "description": "A 90-minute live simulation game teaching Web Advertising and Real-Time Bidding mechanics. Students manage budgets, optimize ROAS, and avoid the Winner's Curse.",
      "badges": [
        "Role: AdTech Bidders",
        "Time Limit: 90 Minutes",
        "Vickrey Second-Price Auction"
      ]
    },
    {
      "type": "key_value_grid",
      "title": "Simulation Constraints",
      "items": [
        {
          "label": "Budget",
          "value": "$50.00 Starting Budget per Team"
        },
        {
          "label": "Payouts",
          "value": "Exact Match ($15), Broad Match ($5), Miss ($0)"
        },
        {
          "label": "Pricing Rule",
          "value": "Vickrey Second-Price Auction (Winner pays 2nd highest bid + $0.01)"
        },
        {
          "label": "Winning Condition",
          "value": "Highest Net Profit (Revenue - Ad Spend)"
        }
      ]
    },
    {
      "type": "callout",
      "tone": "info",
      "title": "Rules Overview (To Read to Students)",
      "body": "Welcome to the RTB Arena. You represent one of 4 e-commerce brands: SneakerX, TechGadget, GlowBeauty, or FitGear. You start with $50.00. I will present a user profile. You will blindly submit your bid. The highest bidder wins the ad slot and pays one cent more than the second-highest bid. If the user is an 'Exact Match' to your brand, you earn $15 in revenue. 'Broad Match' earns $5. 'Miss' earns $0. The goal is to maximize Net Profit (Revenue minus Spend), not just to win auctions. Be careful not to drain your budget on low-value users!"
    },
    {
      "type": "part_block",
      "eyebrow": "Instructor Guide",
      "title": "Step-by-Step Workflow (< 90 seconds per round)",
      "description": "Follow this loop to keep the energy high and the pace fast.",
      "tasks": [
        "**Announce:** Read the User Profile / Search Query aloud to the room.",
        "**Evaluate:** Give teams 15 seconds to determine if they are an Exact Match, Broad Match, or Miss.",
        "**Bid:** Count down from 5. All teams hold up their whiteboards/cards with their bid amount simultaneously.",
        "**Resolve:** Identify the highest bidder. Identify the second-highest bid.",
        "**Calculate:** Highest bidder pays (Second Highest Bid + $0.01). Calculate their revenue based on match type.",
        "**Log:** Record the result on the public Game Master Ledger (Spend and Revenue)."
      ]
    },
